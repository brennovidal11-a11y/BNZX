Players.PlayerAdded:Connect(
    function(player)

        task.wait(1)

        if BoxEnabled
            or NameEnabled
            or DistanceEnabled
        then

            CreateVisual(player)

        end

        if PlayerDropdown
            and PlayerDropdown.SetValues
        then

            PlayerDropdown:SetValues(
                GetPlayersList()
            )

        end

        player.CharacterAdded:Connect(
            function()

                task.wait(0.5)

                if BoxEnabled
                    or NameEnabled
                    or DistanceEnabled
                then

                    CreateVisual(
                        player
                    )

                end

            end
        )

    end
)

Players.PlayerRemoving:Connect(
    function(player)

        RemoveVisual(
            player
        )

        if SelectedPlayer ==
            player
        then

            SelectedPlayer =
                nil

        end

        if PlayerDropdown
            and PlayerDropdown.SetValues
        then

            PlayerDropdown:SetValues(
                GetPlayersList()
            )

        end

    end
)

