-- =========================================================
-- AUXILIARES
-- =========================================================

local function GetCharacter(player)

    return player
        and player.Character

end

local function GetRoot(player)

    local character =
        GetCharacter(player)

    return character
        and character:FindFirstChild(
            "HumanoidRootPart"
        )

end

local function GetPlayersList()

    local result = {}

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            table.insert(
                result,
                player.Name
            )

        end

    end

    table.sort(result)

    return result

end

-- =========================================================
-- FOV VISUAL
-- =========================================================

local FOVGui
local FOVCircle

local function DestroyFOV()

    if FOVGui then

        FOVGui:Destroy()

        FOVGui = nil
        FOVCircle = nil

    end

end

local function CreateFOV()

    DestroyFOV()

    if not FOVEnabled then
        return
    end

    FOVGui = Instance.new(
        "ScreenGui"
    )

    FOVGui.Name =
        "BZNX_FOV"

    FOVGui.IgnoreGuiInset =
        true

    FOVGui.ResetOnSpawn =
        false

    FOVGui.DisplayOrder =
        50

    FOVGui.Parent =
        PlayerGui

    FOVCircle =
        Instance.new("Frame")

    FOVCircle.Name =
        "Circle"

    FOVCircle.AnchorPoint =
        Vector2.new(
            0.5,
            0.5
        )

    FOVCircle.Position =
        UDim2.fromScale(
            0.5,
            0.5
        )

    FOVCircle.Size =
        UDim2.fromOffset(
            FOVRadius * 2,
            FOVRadius * 2
        )

    FOVCircle.BackgroundTransparency =
        1

    FOVCircle.Parent =
        FOVGui

    local Corner =
        Instance.new("UICorner")

    Corner.CornerRadius =
        UDim.new(1, 0)

    Corner.Parent =
        FOVCircle

    local Stroke =
        Instance.new("UIStroke")

    Stroke.Color =
        RED

    Stroke.Thickness =
        2

    Stroke.Transparency =
        0.1

    Stroke.Parent =
        FOVCircle

end

-- =========================================================
-- DEBUG VISUAL
-- =========================================================

local function RemoveVisual(player)

    local character =
        GetCharacter(player)

    if not character then
        return
    end

    local object =
        character:FindFirstChild(
            "BZNX_DebugVisual"
        )

    if object then
        object:Destroy()
    end

    DebugObjects[player] =
        nil

end

local function CreateVisual(player)

    if player == LocalPlayer then
        return
    end

    local character =
        GetCharacter(player)

    if not character then
        return
    end

    RemoveVisual(player)

    if not BoxEnabled
        and not NameEnabled
        and not DistanceEnabled
    then
        return
    end

    local folder =
        Instance.new("Folder")

    folder.Name =
        "BZNX_DebugVisual"

    folder.Parent =
        character

    DebugObjects[player] =
        folder

    -- =====================================================
    -- CAIXA DE DEBUG
    -- =====================================================

    if BoxEnabled then

        local Highlight =
            Instance.new("Highlight")

        Highlight.Name =
            "DebugBox"

        Highlight.FillColor =
            BLUE

        Highlight.OutlineColor =
            WHITE

        Highlight.FillTransparency =
            0.88

        Highlight.OutlineTransparency =
            0

        Highlight.DepthMode =
            Enum.HighlightDepthMode.Occluded

        Highlight.Adornee =
            character

        Highlight.Parent =
            folder

    end

    -- =====================================================
    -- NOME / DISTÂNCIA
    -- =====================================================

    if NameEnabled
        or DistanceEnabled
    then

        local root =
            GetRoot(player)

        if root then

            local Billboard =
                Instance.new(
                    "BillboardGui"
                )

            Billboard.Name =
                "Info"

            Billboard.Size =
                UDim2.fromOffset(
                    200,
                    35
                )

            Billboard.StudsOffset =
                Vector3.new(
                    0,
                    3,
                    0
                )

            Billboard.AlwaysOnTop =
                true

            Billboard.MaxDistance =
                1000

            Billboard.Adornee =
                root

            Billboard.Parent =
                folder

            local Label =
                Instance.new(
                    "TextLabel"
                )

            Label.Size =
                UDim2.fromScale(
                    1,
                    1
                )

            Label.BackgroundTransparency =
                1

            Label.TextColor3 =
                WHITE

            Label.TextStrokeTransparency =
                0.35

            Label.Font =
                Enum.Font.GothamBold

            Label.TextSize =
                12

            Label.Parent =
                Billboard

            task.spawn(function()

                while Billboard.Parent do

                    local text = ""

                    if NameEnabled then

                        text =
                            player.DisplayName

                    end

                    if DistanceEnabled then

                        local myRoot =
                            GetRoot(
                                LocalPlayer
                            )

                        local targetRoot =
                            GetRoot(player)

                        if myRoot
                            and targetRoot
                        then

                            local distance =
                                math.floor(
                                    (
                                        myRoot.Position
                                        -
                                        targetRoot.Position
                                    ).Magnitude
                                )

                            if text ~= "" then

                                text =
                                    text
                                    .. " • "

                            end

                            text =
                                text
                                .. distance
                                .. " studs"

                        end

                    end

                    Label.Text =
                        text

                    task.wait(
                        0.1
                    )

                end

            end)

        end

    end

end

local function RefreshVisuals()

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            CreateVisual(
                player
            )

        end

    end

end

local function ClearVisuals()

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        RemoveVisual(
            player
        )

    end

end

